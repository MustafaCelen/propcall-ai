# Bu değerler ilk kurulum içindir. Kurulumdan sonra hepsi
# /admin panelinden (şifre korumalı) değiştirilebilir — restart gerekmez.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Opsiyonel — header'da ElevenLabs karakter kotasını göstermek için
ELEVENLABS_API_KEY=

PORT=3000
DATABASE_URL=postgresql://postgres:propcall123@localhost:5433/propcall

# ─── Admin Panel (/admin) ─────────────────────────────────────────
# Panel şifresi — API key'leri arayüzden yönetmek için
ADMIN_PASSWORD=

# Admin panelden girilen key'leri şifrelemek için 32 byte base64 anahtar.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=
