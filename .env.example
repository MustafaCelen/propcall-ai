# ═══════════════════════════════════════════════════════════════════
# PropCall AI — Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ─── Anthropic (özet üretimi için, şirket sağlar) ─────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Auth — Google OAuth ─────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
# OAuth 2.0 Client ID (Web application) oluştur, redirect URI:
#   https://YOURDOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sadece bu email domainlerindeki kullanıcılar giriş yapabilir.
# Boş bırakılırsa herkes girebilir (dev için).
# Örn: kw.com.tr,karma.com.tr
ALLOWED_EMAIL_DOMAINS=

# ─── Secrets encryption (Vapi/ElevenLabs API key'leri için) ──────
# 32 byte base64. Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=

# ─── App URL (webhook URL'i için gerekli) ────────────────────────
APP_URL=http://localhost:3000

# ─── Legacy — kaldırılacak, artık user başına ────────────────────
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_ASSISTANT_ID=
# ELEVENLABS_API_KEY=

# ─── Server ──────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgresql://postgres:propcall123@localhost:5433/propcall
